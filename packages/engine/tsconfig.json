{
  /* Everything in the package, tests included. Tests may read fixtures from
     disk, so this config has Node + Vitest types; the purity gate for the
     source itself is tsconfig.lib.json. */
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — consumers (Vite, tsx, Vitest) load the source directly. */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
