{
  "about": "TODO 4.4 / ADR-0039: natural-language requests with the ConstraintSpec each should translate to, against the committed sample account (packages/engine/src/import/__fixtures__/sample-account.good.json; its artifacts are m1-0 ... m1-19 in a fresh store). Expected specs are minimal: only what the request says, extending the character's defaults. npm run spec:eval scores a model on them.",
  "cases": [
    {
      "id": "furina-er-floor",
      "request": "What's my best Furina build with at least 180% ER?",
      "expected": {
        "character": "furina",
        "minStats": {
          "er_pct": 180
        }
      }
    },
    {
      "id": "neuvillette-crit-floor",
      "request": "Neuvillette with at least 70% crit rate",
      "expected": {
        "character": "neuvillette",
        "minStats": {
          "crit_rate": 70
        }
      }
    },
    {
      "id": "xiangling-two-floors",
      "request": "Build Xiangling with 200 ER and at least 300 elemental mastery",
      "expected": {
        "character": "xiangling",
        "minStats": {
          "er_pct": 200,
          "em": 300
        }
      }
    },
    {
      "id": "raiden-4pc",
      "request": "Raiden Shogun in 4-piece Emblem of Severed Fate",
      "expected": {
        "character": "raiden_shogun",
        "set": {
          "kind": "4pc",
          "setKey": "EmblemOfSeveredFate"
        }
      }
    },
    {
      "id": "bennett-4pc-sands",
      "request": "Bennett with 4pc Noblesse Oblige and an HP% sands",
      "expected": {
        "character": "bennett",
        "set": {
          "kind": "4pc",
          "setKey": "NoblesseOblige"
        },
        "mainStats": {
          "sands": "hp_pct"
        }
      }
    },
    {
      "id": "kazuha-full-em",
      "request": "Kazuha in 4-piece Viridescent Venerer with EM on the sands, goblet and circlet",
      "expected": {
        "character": "kaedehara_kazuha",
        "set": {
          "kind": "4pc",
          "setKey": "ViridescentVenerer"
        },
        "mainStats": {
          "sands": "em",
          "goblet": "em",
          "circlet": "em"
        }
      }
    },
    {
      "id": "neuvillette-2plus2",
      "request": "Neuvillette with 2-piece Marechaussee Hunter and 2-piece Golden Troupe",
      "expected": {
        "character": "neuvillette",
        "set": {
          "kind": "2+2",
          "setKeys": ["GoldenTroupe", "MarechausseeHunter"]
        }
      }
