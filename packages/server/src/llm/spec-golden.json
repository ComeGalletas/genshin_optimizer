    {
      "id": "furina-any-set",
      "request": "Best Furina build with any artifact set",
      "expected": {
        "character": "furina",
        "set": {
          "kind": "any"
        }
      }
    },
    {
      "id": "xingqiu-2pc",
      "request": "Xingqiu with 2-piece Noblesse Oblige",
      "expected": {
        "character": "xingqiu",
        "set": {
          "kind": "2pc",
          "setKey": "NoblesseOblige"
        }
      }
    },
    {
      "id": "charlotte-healing",
      "request": "Charlotte, no set requirement, maximise healing bonus",
      "expected": {
        "character": "charlotte",
        "set": {
          "kind": "any"
        },
        "objective": "healing"
      }
