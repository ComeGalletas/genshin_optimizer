# Copy to .env (or .env.local; never commit either) and fill in real values.
# The app runs without any of these.
#
# Read only by the local server (packages/server), never by the browser
# bundle: nothing secret gets a VITE_ prefix. Which provider is used is set
# in config/llm.json; see docs/adr/0032-llm-provider-config.md.

# Needed when config/llm.json says "provider": "anthropic".
ANTHROPIC_API_KEY=

# Optional, for "provider": "openai_compatible" servers that check a key
# (OpenRouter, a hosted vLLM...). Local servers such as LM Studio don't.
OPENAI_API_KEY=

# Where the web app looks for the local server. Not a secret (it's inlined
# into the browser bundle). Default: http://127.0.0.1:5198 (npm run server).
# VITE_SERVER_URL=
