# Copy to .env.local (never commit that file) and fill in real values.
# The app runs without any of these.

# Anthropic key for the AI features, read only by the local server
# (packages/server, Phase 3). Server-side only: it must never reach the
# browser bundle, so no VITE_ prefix.
ANTHROPIC_API_KEY=

# Build-time flag that renders the "Explain this build" button. Keep it off:
# nothing serves /api/explain until the local server rebuilds it in Phase 3.
VITE_AI_ENABLED=
