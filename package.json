{
  "name": "rpg-build-optimizer",
  "private": true,
  "version": "0.0.0",
  "description": "Exact branch-and-bound artifact optimizer for Genshin Impact — find the provably best five-piece build from the gear you own, 100% client-side, shareable as a single link.",
  "homepage": "https://rpg-build-optimizer.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natcat38/rpg-build-optimizer.git"
  },
  "keywords": [
    "genshin-impact",
    "artifact-optimizer",
    "branch-and-bound",
    "combinatorial-optimization",
    "react",
    "typescript",
    "web-workers"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:data": "tsx scripts/build-dataset.ts",
    "bench": "tsx scripts/benchmark.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "bench:check": "tsx scripts/check-bench.ts",
    "size:check": "tsx scripts/check-size.ts",
    "size:update": "tsx scripts/check-size.ts --update"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "genshin-db": "^5.2.13",
    "globals": "^17.11.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
