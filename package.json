{
  "name": "genshin-build-lab",
  "private": true,
  "version": "0.0.0",
  "description": "Local Genshin Impact account advisor: exact artifact optimizer over the gear you own, with gcsim simulation and an LLM interface on the roadmap. Fork of natcat38/rpg-build-optimizer.",
  "homepage": "https://github.com/ComeGalletas/genshin_optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComeGalletas/genshin_optimizer.git"
  },
  "keywords": [
    "genshin-impact",
    "artifact-optimizer",
    "branch-and-bound",
    "combinatorial-optimization",
    "react",
    "typescript",
    "web-workers"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "npm run dev -w @genshin-build-lab/web --",
    "build": "tsc -b && npm run build -w @genshin-build-lab/web",
    "preview": "npm run preview -w @genshin-build-lab/web --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.scripts.json",
    "build:data": "tsx scripts/build-dataset.ts",
    "sources": "tsx packages/server/src/cli/sources.ts",
    "data:guides": "tsx scripts/data-guides.ts",
    "data:coverage": "tsx scripts/data-coverage.ts",
    "prospects": "tsx scripts/prospects.ts",
    "server": "tsx packages/server/src/cli/serve.ts",
    "mcp": "tsx packages/server/src/cli/mcp.ts",
    "mcp:config": "tsx scripts/mcp-config.ts",
    "inbox": "tsx packages/server/src/cli/inbox.ts",
    "llm:check": "tsx packages/server/src/cli/llm-check.ts",
    "spec:eval": "tsx packages/server/src/cli/spec-eval.ts",
    "sim:check": "tsx packages/server/src/cli/sim-check.ts",
    "sim:support": "tsx packages/server/src/cli/sim-support.ts",
    "rotations": "tsx packages/server/src/cli/rotations.ts",
    "phase2:check": "tsx packages/server/src/cli/phase2-check.ts",
    "diff:sim": "tsx scripts/diff-sim.ts",
    "bench": "tsx scripts/benchmark.ts && prettier --write docs/speed-report.md",
    "docs:check": "tsx scripts/check-docs.ts",
    "bench:check": "tsx scripts/check-bench.ts",
    "size:check": "tsx scripts/check-size.ts",
    "size:update": "tsx scripts/check-size.ts --update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "genshin-db": "^5.2.14",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
