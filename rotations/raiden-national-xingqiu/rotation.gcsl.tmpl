# Raiden National with Xingqiu, five rotations of about 21 s:
# Xingqiu E dash Q N1 > Bennett Q N1 E > Xiangling N1 Q N1 E dash >
# Bennett N1 E > Raiden N1 Q N4 E N4D N4D N4 > Bennett N2 E
{{raiden}} skill;
for let x = 0; x < 5; x = x + 1 {
  {{xingqiu}} skill, dash, burst, attack;
  {{bennett}} burst, attack, skill;
  {{xiangling}} attack, burst, attack, skill, dash;
  {{bennett}} attack, skill;
  {{raiden}} attack, burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  {{bennett}} attack:2, skill;
}
