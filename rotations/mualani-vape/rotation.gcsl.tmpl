# Mualani Vaporize, four rotations of about 21 s:
# Mualani N1 > Xilonen Q N1 > Citlali E N1 > Bennett Q E > Xilonen E N2 >
# Mualani E 3[3-stacked bite] > Xilonen E N2 > Mualani Q (or N3C)
# DRAFT: adapted from a Mualani/Citlali/Xilonen/Xiangling config, Bennett
# in Xiangling's place; not yet reviewed by the owner.
fn mualani_combo() {
  # 3[3-stacked bite]
  while .{{mualani}}.nightsoul.state {
    for let k = 0; k < 3; k = k + 1 {
      while .{{mualani}}.momentum < 3 {
        {{mualani}} walk[f=1];
      }
      {{mualani}} attack;
    }
    break;
  }
}

for let i = 0; i < 4; i = i + 1 {
  {{mualani}} attack;
  {{xilonen}} burst, attack;
  {{citlali}} skill, attack;
  {{bennett}} burst, skill;
  {{xilonen}} skill, attack:2;
  {{mualani}} skill;
  mualani_combo();
  {{mualani}} walk[f=1];
  {{xilonen}} skill, attack:2;
  if .{{mualani}}.burst.ready && .{{mualani}}.energy == .{{mualani}}.energymax {
    {{mualani}} burst;
  } else {
    {{mualani}} attack:3, charge;
  }
}
