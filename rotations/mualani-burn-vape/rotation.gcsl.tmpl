# Mualani Burn-Vape, four rotations of about 16 s (32 s pairs); everyone
# bursts every other rotation:
# Mavuika Q CD E > Emilie E > Xilonen E N2 > Mualani E 3[3-stacked bite] Q > Xilonen Q >
# Mavuika      E > Emilie Q > Xilonen E N2 > Mualani E 3[3-stacked bite]
fn mualani_combo() {
  # 3[3-stacked bite]
  while .{{mualani}}.nightsoul.state {
    for let k = 0; k < 3; k = k + 1 {
      while .{{mualani}}.momentum < 3 {
        {{mualani}} walk[f=1];
      }
      {{mualani}} attack;
    }
    break;
  }
}

{{mualani}} attack:2;
for let i = 0; i < 4; i = i + 1 {
  if is_even(i) {
    {{mavuika}} burst, charge, dash, skill;
    {{emilie}} skill, attack;
  } else {
    {{mavuika}} skill, attack;
    {{emilie}} burst;
  }
  {{xilonen}} skill, attack:2;
  {{mualani}} skill;
  mualani_combo();
  if is_even(i) {
    {{mualani}} burst;
    {{xilonen}} burst;
  } else {
    {{mualani}} walk[f=1];
  }
}
